{% extends 'base.html.twig' %}

{% block title %}Батлпассы - {{ parent() }}{% endblock %}

{% block body %}
    <div class="min-h-screen text-white p-6 font-sans">

        <div class="max-w-7xl bg-linear-[115deg,transparent_0%,#f0f0f0_33%,#220022_75.5%,#aa99aa_76%,#ffbbff_76.5%,transparent_100%] rounded mx-auto flex justify-between items-center mb-8 border border-gray-900/40 pb-4">
            <div>
                <h1 class="mx-10 text-3xl font-black tracking-wide text-gray-900">Мои БП</h1>
                <p class="mx-10 text-xs text-slate-600 mt-1">Управляйте своими активными и входящими батлпассами</p>
            </div>

            <button onclick="document.getElementById('bp-modal').classList.remove('hidden')" class="bg-fuchsia-800 hover:bg-fuchsia-700 text-white font-bold py-2 px-6 mx-8 rounded-sm text-sm transition-all shadow-lg shadow-fuchsia-800/10">
                + Создать БП
            </button>
        </div>

        <div class="max-w-7xl mx-auto space-y-6 bg-gray-500/50 p-2">
            {% if battlepasses is empty %}
                <div class="border border-dashed border-purple-900 rounded-sm p-12 text-center bg-gray-900/20">
                    <div class="text-4xl mb-3">🏆</div>
                    <div class="text-sm text-slate-400 font-medium">У вас пока нет ни одного батлпасса.</div>
                    <p class="text-xs text-gray-500 mt-1">Нажмите кнопку выше, чтобы пригласить напарника в игру!</p>
                </div>
            {% else %}
                {% for battlepass in battlepasses %}
                    <div class="border border-purple-300 rounded-sm p-1 bg-taupe-100 shadow-xl">

                        <div class="relative w-full rounded-sm overflow-hidden flex flex-col md:flex-row p-6 items-center justify-between gap-6 min-h-[120px]">

                            <div class="flex-1 flex flex-col md:flex-row items-start md:items-center gap-6">
                                <div class="bg-[linear-gradient(90deg,rgba(162,28,175,0.15)_0%,transparent_100%)] p-3 border-l-2 border-fuchsia-600/40 text-2xl">
                                    🏆
                                </div>

                                <div>
                                    <h2 class="text-xl font-black text-gray-900 tracking-wide">{{ battlepass.title }}</h2>
                                    <div class="text-xs text-slate-600 mt-1 flex flex-wrap gap-x-4">
                                        <span>Создатель: <strong class="text-purple-600">{{ battlepass.player1.username }}</strong></span>
                                        <span class="text-slate-600">|</span>
                                        <span>Оппонент: <strong class="text-fuchsia-600">{{ battlepass.player2.username }}</strong></span>
                                    </div>
                                    <div class="text-[11px] text-gray-500 mt-1 font-mono">
                                        Период: {{ battlepass.startAt|date('d.m.Y') }} — {{ battlepass.endAt|date('d.m.Y') }}
                                    </div>
                                </div>
                            </div>

                            <div class="flex items-center gap-4 shrink-0 pr-4">

                                {% if battlepass.status.value == 'pending' %}

                                    {% if battlepass.player2 == app.user %}
                                        <div class="flex gap-2">
                                            <form action="{{ path('app_battlepass_accept', {'id': battlepass.id}) }}" method="POST">
                                                <button type="submit" class="bg-fuchsia-600 hover:bg-fuchsia-700 text-white font-bold py-1.5 px-4 rounded-sm text-xs transition-colors shadow-md">
                                                    Принять
                                                </button>
                                            </form>
                                            <form action="{{ path('app_battlepass_decline', {'id': battlepass.id}) }}" method="POST">
                                                <button type="submit" class="bg-gray-800 hover:bg-gray-700 text-gray-400 py-1.5 px-4 rounded-sm text-xs transition-colors">
                                                    Отклонить
                                                </button>
                                            </form>
                                        </div>
                                    {% else %}
                                        <span class="text-xs bg-yellow-500/10 border border-yellow-500/30 text-yellow-400 px-3 py-1 rounded-sm uppercase tracking-wider font-bold animate-pulse">
                                        Ожидает ответа оппонента
                                    </span>
                                    {% endif %}

                                {% elseif battlepass.status.value == 'active' %}
                                    <span class="text-xs bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 px-4 py-1.5 rounded-sm uppercase tracking-widest font-black">
                                    В процессе ⚔️
                                </span>
                                    <a href="{{ path('app_battlepass_show', {'id': battlepass.id}) }}" class="text-xs text-purple-600 hover:text-purple-500 font-bold underline transition-colors ml-2">Открыть квесты →</a>

                                {% elseif battlepass.status.value == 'declined' %}
                                    <span class="text-xs bg-red-500/10 border border-red-500/30 text-red-400 px-3 py-1 rounded-sm uppercase tracking-wider font-bold">
                                    Отклонён ❌
                                </span>

                                {% elseif battlepass.status.value == 'finished' %}
                                    <span class="text-xs bg-slate-800 border border-slate-700 text-slate-400 px-3 py-1 rounded-sm uppercase tracking-wider font-bold">
                                    Завершён 🏁
                                </span>
                                {% endif %}

                            </div>

                        </div>
                    </div>
                {% endfor %}
            {% endif %}
        </div>

        <div id="bp-modal" class="hidden fixed inset-0 bg-black/80 backdrop-blur-sm flex items-center justify-center z-50 p-4">
            <div class="bg-gray-900 border border-purple-900/40 p-6 rounded-sm max-w-md w-full relative shadow-2xl">

                <h2 class="text-xl font-bold mb-4 text-fuchsia-400">Создание нового батлпасса</h2>

                <form action="{{ path('app_battlepass_create') }}" method="POST" class="space-y-4">
                    <input type="hidden" name="_token" value="{{ csrf_token('battlepass_create') }}">

                    <div>
                        <label class="block text-xs uppercase tracking-widest text-slate-400 font-bold mb-1">Название</label>
                        <input type="text" name="title" required class="w-full p-2.5 rounded-sm bg-gray-800 border border-purple-900/40 text-white text-sm focus:border-fuchsia-500 outline-none">
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs uppercase tracking-widest text-slate-400 font-bold mb-1">Старт</label>
                            <input type="date" name="start_date" required class="w-full p-2.5 rounded-sm bg-gray-800 border border-purple-900/40 text-white text-sm outline-none focus:border-fuchsia-500">
                        </div>
                        <div>
                            <label class="block text-xs uppercase tracking-widest text-slate-400 font-bold mb-1">Конец</label>
                            <input type="date" name="end_date" required class="w-full p-2.5 rounded-sm bg-gray-800 border border-purple-900/40 text-white text-sm outline-none focus:border-fuchsia-500">
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs uppercase tracking-widest text-slate-400 font-bold mb-1">Email напарника</label>
                        <input type="email" name="opponent_email" required class="w-full p-2.5 rounded-sm bg-gray-800 border border-purple-900/40 text-white text-sm outline-none focus:border-fuchsia-500">
                    </div>

                    <div class="flex justify-end gap-3 mt-6 border-t border-purple-900/20 pt-4">
                        <button type="button" onclick="document.getElementById('bp-modal').classList.add('hidden')" class="bg-gray-800 text-gray-400 px-4 py-2 rounded-sm text-sm hover:bg-gray-700 transition-colors">Отмена</button>
                        <button type="submit" class="bg-fuchsia-600 hover:bg-fuchsia-700 text-white px-5 py-2 rounded-sm text-sm font-bold transition-colors">Создать</button>
                    </div>
                </form>

            </div>
        </div>

    </div>
{% endblock %}
