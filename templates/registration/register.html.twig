{% extends 'base.html.twig' %}

{% block title %}Регистрация - {{ parent() }}{% endblock %}

{% block body %}
    <div class="min-h-[calc(100vh-3.5rem)] flex items-center justify-center px-4 dark:bg-gray-950 transition-colors duration-300 py-10">

        <div class="max-w-md w-full border border-purple-900/30 dark:border-purple-500/20 rounded-sm p-1 bg-gradient-to-br from-gray-200/50 via-gray-300/30 to-fuchsia-900/20 dark:from-neutral-950 dark:via-slate-900 dark:to-purple-950/40 shadow-2xl">

            <div class="relative bg-[linear-gradient(30deg,var(--tw-gradient-stops))] from-white via-slate-50 to-purple-100/40 dark:from-neutral-950 dark:via-slate-950 dark:to-purple-950/20 rounded-sm p-8 border border-purple-500/10">

                <div class="absolute top-0 bottom-0 left-0 w-1 bg-gradient-to-b from-fuchsia-600/40 via-purple-600/20 to-transparent"></div>

                <div class="mb-6">
                    <h1 class="text-3xl font-black tracking-wide text-slate-900 dark:text-white mt-3">Регистрация</h1>
                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Создайте аккаунт, чтобы бросить вызов оппонентам</p>
                </div>

                {% if registrationForm is defined and not registrationForm.vars.valid %}
                    <div class="bg-red-500/10 border border-red-500/30 text-red-600 dark:text-red-400 p-3 rounded-sm text-xs font-semibold mb-4">
                        Пожалуйста, исправьте ошибки в полях формы.
                    </div>
                {% endif %}

                <form method="post" class="space-y-4">
                    {{ form_start(registrationForm, {'attr': {'class': 'space-y-4'}}) }}

                    <div>
                        {{ form_label(registrationForm.username, null, {
                            'label_attr': {'class': 'block text-xs uppercase tracking-widest text-slate-500 dark:text-slate-400 font-bold mb-1.5'}
                        }) }}

                        <div class="bg-[linear-gradient(90deg,rgba(162,28,175,0.08)_0%,transparent_100%)] pl-3 border-l-2 border-fuchsia-600/30">
                            {{ form_widget(registrationForm.username, {
                                'attr': {'class': 'w-full p-2.5 rounded-sm bg-white dark:bg-gray-900 border border-slate-300 dark:border-purple-900/40 text-slate-900 dark:text-white text-sm outline-none focus:border-fuchsia-500 transition-all', 'placeholder': 'Abobus'}
                            }) }}
                        </div>

                        <div class="text-xs text-red-500 mt-1 font-semibold">
                            {{ form_errors(registrationForm.username) }}
                        </div>
                    </div>

                    <div>
                        {{ form_label(registrationForm.email, null, {
                            'label_attr': {'class': 'block text-xs uppercase tracking-widest text-slate-500 dark:text-slate-400 font-bold mb-1.5'}
                        }) }}

                        <div class="bg-[linear-gradient(90deg,rgba(148,163,184,0.15)_0%,transparent_100%)] pl-3 border-l-2 border-slate-400/40">
                            {{ form_widget(registrationForm.email, {
                                'attr': {'class': 'w-full p-2.5 rounded-sm bg-white dark:bg-gray-900 border border-slate-300 dark:border-purple-900/40 text-slate-900 dark:text-white text-sm outline-none focus:border-fuchsia-500 transition-all', 'placeholder': 'player@example.com'}
                            }) }}
                        </div>

                        <div class="text-xs text-red-500 mt-1 font-semibold">
                            {{ form_errors(registrationForm.email) }}
                        </div>
                    </div>

                    <div>
                        {{ form_label(registrationForm.plainPassword, null, {
                            'label_attr': {'class': 'block text-xs uppercase tracking-widest text-slate-500 dark:text-slate-400 font-bold mb-1.5'}
                        }) }}

                        <div class="bg-[linear-gradient(90deg,rgba(147,51,234,0.06)_0%,transparent_100%)] pl-3 border-l-2 border-purple-500/20">
                            {{ form_widget(registrationForm.plainPassword, {
                                'attr': {'class': 'w-full p-2.5 rounded-sm bg-white dark:bg-gray-900 border border-slate-300 dark:border-purple-900/40 text-slate-900 dark:text-white text-sm outline-none focus:border-fuchsia-500 transition-all'}
                            }) }}
                        </div>

                        <div class="text-xs text-red-500 mt-1 font-semibold">
                            {{ form_errors(registrationForm.plainPassword) }}
                        </div>
                    </div>

                    <div class="pt-4 flex flex-col gap-4">
                        <button type="submit" class="w-full bg-gradient-to-r from-purple-600 to-fuchsia-600 hover:from-purple-700 hover:to-fuchsia-700 text-white font-black py-3 rounded-sm text-sm uppercase tracking-wider transition-colors shadow-lg shadow-purple-500/10">
                            Создать аккаунт
                        </button>

                        <div class="text-center">
                            <a href="{{ path('app_login') }}" class="text-xs text-purple-700 dark:text-purple-400 font-bold hover:underline transition-colors">
                                Уже зарегистрированы? Войти в аккаунт →
                            </a>
                        </div>
                    </div>
                    {{ form_end(registrationForm) }}
                </form>
            </div>
        </div>
    </div>
{% endblock %}
