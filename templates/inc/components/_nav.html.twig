<nav class="w-full h-16 bg-gradient-to-r from-gray-950 via-fuchsia-800 to-gray-950 flex justify-between items-center px-4">
    <div class="flex items-center gap-4 text-white">
        <a href="{{ path('app_home') }}" class="text-white font-bold text-lg hover:text-fuchsia-300 transition-colors">
            IRL Battlepass
        </a>
    </div>
    <div class="flex items-center gap-4 text-white">
        {% if app.user %}
            {% set unread_notifications = get_notifications() %}
            {% set notifications_count = unread_notifications|length %}
                <div class="relative group">
                    <button onclick="document.getElementById('invites-dropdown').classList.toggle('hidden')"
                            class="p-2 rounded-sm transition-all outline-none focus:outline-none relative duration-300
                        {% if notifications_count > 0 %}
                            text-yellow-400 hover:text-yellow-300 animate-bounce drop-shadow-[0_0_8px_rgba(234,179,8,0.5)]
                        {% else %}
                            text-slate-400 hover:text-white hover:bg-purple-950/30
                        {% endif %}">

                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://w3.org">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
                        </svg>

                        {% if notifications_count > 0 %}
                            <span class="absolute top-1 right-1 bg-red-600 text-white text-[10px] font-black w-4 h-4 rounded-full flex items-center justify-center border border-gray-900 shadow-md animate-pulse">
                            {{ notifications_count }}
                        </span>
                        {% endif %}
                    </button>

                    <div id="invites-dropdown" class="hidden absolute right-0 mt-3 w-80 bg-gray-950 border border-purple-900/40 rounded-sm shadow-2xl p-4 z-50 text-sm text-white">
                        <h3 class="font-bold text-fuchsia-400 mb-3 uppercase tracking-wider text-xs">Уведомления</h3>

                        {% if notifications_count > 0 %}
                            <div class="space-y-3">
                                {% for notification in unread_notifications %}
                                    <div class="bg-gray-900/50 p-3 border border-purple-500/10 rounded-sm">
                                        <div class="font-bold text-slate-200 mb-1">{{ notification.title }}</div>
                                        <div class="text-xs text-slate-400 mb-3">{{ notification.message }}</div>

                                        {% if notification.url %}
                                            <a href="{{ path('app_notification_go', {'id': notification.id}) }}" class="block w-full text-center bg-fuchsia-600 hover:bg-fuchsia-700 text-white font-bold py-1.5 rounded-sm text-xs transition-colors shadow-lg shadow-fuchsia-600/10">
                                                Открыть
                                            </a>
                                        {% endif %}
                                    </div>
                                {% endfor %}
                            </div>
                        {% else %}
                            <div class="text-gray-500 text-xs py-4 text-center">Новых уведомлений нет</div>
                        {% endif %}
                    </div>
                </div>
            <span class="font-medium hover:text-fuchsia-300 transition-colors">
                <a href="{{ path('app_profile') }}">{{ app.user.username }}</a>
            </span>
            <a href="{{ path('app_logout') }}" class="bg-red-600 hover:bg-red-700 text-white font-semibold py-1.5 px-4 rounded transition-colors text-sm">
                Выйти
            </a>
        {% else %}
            <a href="{{ path('app_login') }}" class="text-gray-300 hover:text-white transition-colors text-sm">Вход</a>
            <a href="{{ path('app_register') }}" class="bg-fuchsia-800 hover:bg-fuchsia-700 text-white font-semibold py-1.5 px-4 rounded transition-colors text-sm">
                Регистрация
            </a>
        {% endif %}
    </div>
</nav>
